// Migrated from arm/bfs-UNSAT.ml  (NEGATIVE TEST: must FAIL)
// sqrt search over {2,3} for `squared`; the answer wrongly excludes Success(2),
// which is the result when squared = 4.
type result = | Failure | Success of int
effect Select { select: () -> bool }
def bfs(squared: { z: int | z == 4 || z == 9 }):
    { z: result | z == Failure || z == Success(3) } {
    handle <> { [r, e] =>
        val b = raise sel.select();
        (fun <> (): { z: result | z == Failure || z == Success(3) } {
            if b then (if 2 * 2 == squared then Success(2) else Failure)
            else (if 3 * 3 == squared then Success(3) else Failure)
        })()
    } with sel: Select {
        hdl_s select(k) {
            val r = resume k true;
            match r with
            | Failure -> { resume_final k false }
            | Success (y) -> { Success(y) }
        }
    }: { z: result | z == Failure || z == Success(3) }
}
