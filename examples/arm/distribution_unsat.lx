// Migrated from arm/distribution-UNSAT.ml  (NEGATIVE TEST: must FAIL)
//
// A distribution with one pick is not empty.

type pair = | P of int * int
type plist = | Nil | Cons of pair * plist

effect Pick {
    pick: forall 'dummy. (p: int, a: int, b: int) ->
        bool
            / (choice. { z: plist |
                (choice == true && z == Cons(P(a, 100), Nil)) ||
                (choice == false && z == Cons(P(b, 100), Nil)) })
            => { z: plist |
                (a == b && z == Cons(P(a, 100), Nil)) ||
                (a != b && z == Cons(P(a, p), Cons(P(b, 100 - p), Nil))) }
}

def distribution(p: { z: int | 0 <= z && z <= 100 }, a: int, b: int): { z: plist | z == Nil } {
    handle <> {
        val d = raise pk.pick[int](p, a, b);
        (fun <> (): { z: plist |
            (d == true && z == Cons(P(a, 100), Nil)) ||
            (d == false && z == Cons(P(b, 100), Nil)) } {
            if d then Cons(P(a, 100), Nil) else Cons(P(b, 100), Nil)
        })()
    } with pk: Pick {
        hdl_s pick(p0, a0, b0, k) {
            val d1 = resume k true;
            val d2 = resume_final k false;
            (fun <> (): { z: plist |
                (a0 == b0 && z == Cons(P(a0, 100), Nil)) ||
                (a0 != b0 && z == Cons(P(a0, p0), Cons(P(b0, 100 - p0), Nil))) } {
                if a0 == b0 then Cons(P(a0, 100), Nil)
                else Cons(P(a0, p0), Cons(P(b0, 100 - p0), Nil))
            })()
        }
    }: { z: plist |
        (a == b && z == Cons(P(a, 100), Nil)) ||
        (a != b && z == Cons(P(a, p), Cons(P(b, 100 - p), Nil))) }
}
