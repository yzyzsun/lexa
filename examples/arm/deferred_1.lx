// Migrated from arm/deferred-1-SAT.ml
//
// Faithful deferred/lazy handler.  The handler state is the original
// Value | Thunk(ctx, thunk) cache; Force either reads the cached value or runs
// the stored thunk once and resumes with Value(v) as the new cache state.

type deferred = | Value of int | Thunk of int * (<> () -> int)

effect Deferred {
    force: forall 'rho: Reg, 'beta: Pred[int], 'gamma: Cty. (r: int) ->
        { z: int | z == r }
            / ((<>(deferred) ->['rho] { z: int | 'beta(z) } / 'gamma => 'gamma) / 'gamma => 'gamma)
            => (<>(deferred) ->['rho] { z: int | 'beta(z) } / 'gamma => 'gamma)
}

def lazy_(r: int, thunk: <> () -> { z: int | z == r }): { z: int | z == r } / int => int {
    val run = handle <> {
        val res = raise d.force[top, Pred(z: Int) { z == r }, int](r);
        (fun <> (): { z: int | z == r } { res })()
    } with d: Deferred {
        return x {
            fun <> (st: deferred): { z: int | z == r } { x }
        }
        hdl_1 force(expected, k) {
            fun <> (st: deferred): { z: int | z == r } / int => int {
                match st with
                | Value (v) -> {
                    val next = resume_final k v;
                    next(Value(v))
                }
                | Thunk (ctx, t) -> {
                    val v = t();
                    val next = resume_final k v;
                    next(Value(v))
                }
            }
        }
    }: <>(deferred) -> { z: int | z == r } / int => int;
    run(Thunk(r, thunk))
}

def test(r: int, thunk: <> () -> { z: int | z == r }): { z: int | z == r } / int => int {
    lazy_(r, thunk)
}
