// Migrated from arm/choose-sum-UNSAT.ml  (NEGATIVE TEST: must FAIL)
//
// The sum over all four leaves is 0, not x + y.

effect Decide {
    decide: forall 'dummy. (on_true: int, on_false: int) ->
        bool
            / (b. { z: int | (b == true && z == on_true) || (b == false && z == on_false) })
            => { z: int | z == on_true + on_false }
}

def choose_sum(x: int, y: int): { z: int | z == x + y } {
    handle <> {
        val d1 = raise dec.decide[int](x - y, y - x);
        val lhs = if d1 then x else y;
        val d2 = raise dec.decide[int](lhs - x, lhs - y);
        (fun <> (): { z: int | (d2 == true && z == lhs - x) || (d2 == false && z == lhs - y) } {
            if d2 then lhs - x else lhs - y
        })()
    } with dec: Decide {
        hdl_s decide(on_true, on_false, k) {
            val a = resume k true;
            val b = resume_final k false;
            (fun <> (): { z: int | z == on_true + on_false } { a + b })()
        }
    }: { z: int | z == 0 }
}
