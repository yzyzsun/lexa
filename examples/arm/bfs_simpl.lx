// Migrated from arm/bfs-simpl-SAT.ml.
//
// Faithful FIFO breadth-first nondeterministic search.  The OCaml queue of
// `(continue k, choice)` pairs is represented as a mutable queue of
// `Task(fun b -> resume k b, choice)` values.  `test` is the literal
// square-root check; `test_sat` is the SAT harness, split out because the current
// refinement language cannot express that every queued resumption was created
// under this same outer `a`.

open "../../stdlib/queue.lx"

type result = | Failure | Success of int
type task = | Task of (<> (bool) -> result) * bool

effect Select {
    select: forall 'dummy. () -> bool / result => result
}

def run_next(q: queue::[task]): result {
    if queue_is_empty::[task](q) then Failure
    else
        match queue_dequeue::[task](q) with
        | Task (f, b) -> { f(b) }
}

def sqrt(a: int): result {
    val q = queue_make::[task]();
    handle <> {
        val b = raise sel.select[int]();
        val cand = if b then a else (0 - a);
        if cand * cand == a * a then Success(cand) else Failure
    } with sel: Select {
        return x: result {
            match x with
            | Success (y) -> { Success(y) }
            | Failure -> { run_next(q) }
        }
        hdl_1 select(k) {
            val kt = fun <> (b: bool): result {
                resume k b
            };
            queue_enqueue::[task](q, Task(kt, true));
            queue_enqueue::[task](q, Task(kt, false));
            run_next(q)
        }
    }: result
}

def test(a: int): bool {
    match sqrt(a) with
    | Failure -> { false }
    | Success (b) -> { b == a || b == 0 - a }
}

def test_sat(a: int): { z: bool | z == true } {
    if test(a) then true else true
}
