// Migrated from arm/round-robin-UNSAT.ml.

open "../../stdlib/queue.lx"

type thread = | Thread of <> () -> unit

effect Sched {
    yield: () -> unit
    spawn: (<> [; h: Sched] () -> unit / unit => unit) -> unit
}

def lower_bound(init: int): { v: int | v >= init } {
    init
}

def make_counter(init: int): ref { v: int | v >= init } {
    newref { lower_bound(init) }
}

def inc(init: int, x: { v: int | v >= init }): { v: int | v >= init } {
    x + 1
}

def round_robin(init: int): { z: int | z == init } {
    val q = queue_make::[thread]();
    val c = make_counter(init);
    rec def dequeue <> (): unit {
        if queue_is_empty::[thread](q) then ()
        else
            match queue_dequeue::[thread](q) with
            | Thread (t) -> { t() }
    }
    and rr_handler <> (body: <> [; h: Sched] () -> unit / unit => unit): unit {
        handle <> {
            body:[; s]()
        } with s: Sched {
            return x: unit { dequeue() }
            hdl_1 yield(k) {
                queue_enqueue::[thread](q, Thread(fun <> (): unit { resume_final k (()) }));
                dequeue()
            }
            hdl_1 spawn(t, k) {
                queue_enqueue::[thread](q, Thread(fun <> (): unit { resume_final k (()) }));
                rr_handler(t)
            }
        }: unit
    };
    rr_handler(fun <> [; h: Sched] (): unit / unit => unit {
        raise h.spawn(fun <> [; h2: Sched] (): unit / unit => unit {
            c[0] := inc(init, c[0]);
            raise h2.yield();
            c[0] := inc(init, c[0]);
            raise h2.yield()
        });
        raise h.spawn(fun <> [; h3: Sched] (): unit / unit => unit {
            c[0] := inc(init, c[0]);
            raise h3.yield();
            c[0] := inc(init, c[0]);
            raise h3.yield()
        })
    });
    c[0]
}
