// Migrated from arm/modulus-UNSAT.ml  (NEGATIVE TEST: must FAIL)

effect Oracle {
    call: forall 'rho: Reg, 'beta: Pred[int], 'gamma: Cty. (n: int, observed: int) ->
        { z: int | z == observed }
            / ((<>(int) ->['rho] { z: int | 'beta(z) } / 'gamma => 'gamma) / 'gamma => 'gamma)
            => (<>(int) ->['rho] { z: int | 'beta(z) } / 'gamma => 'gamma)
}

def max_(a: int, b: int): { z: int | z == a || z == b } {
    if a >= b then a else b
}

def mu(
    f: forall 'rho: Reg.
        <> [; o: Oracle]
        (oracle: <o> (x: int) ->['rho] int / (<>(int) ->['rho] int / int => int) => (<>(int) ->['rho] int / int => int))
        ->['rho] int / (<>(int) ->['rho] int / int => int) => (<>(int) ->['rho] int / int => int),
    sequence: <> (x: int) -> int
): int / int => int {
    val run = handle <> {
        f::[o]:[; o](fun <o> (x: int): int / (<>(int) ->[o] int / int => int) => (<>(int) ->[o] int / int => int) {
            val observed = sequence(x);
            raise o.call[[]; o, Pred(z: Int) { true }, int](x, observed)
        })
    } with o: Oracle {
        return x {
            fun <> (st: int): int { st }
        }
        hdl_1 call(n, observed, k) {
            fun <> (st: int): int / int => int {
                val j = max_(st, n);
                val next = resume_final k observed;
                next(j)
            }
        }
    }: <>(int) -> int / int => int;
    run(0)
}

def probe :: ['rho: Reg] [; o: Oracle] (
    oracle: <o> (x: int) ->['rho] int / (<>(int) ->['rho] int / int => int) => (<>(int) ->['rho] int / int => int)
): int / (<>(int) ->['rho] int / int => int) => (<>(int) ->['rho] int / int => int) {
    0 * oracle(10)
}

def test(
    r: int,
    a: <> (xa: int) -> { z: int | xa != 10 || z == r },
    b: <> (xb: int) -> { z: int | xb != 10 || z == r }
): bool / int => int {
    val left = mu(probe, a);
    val right = mu(probe, b);
    left == right
}

def test_unsat(
    r: int,
    a: <> (xa: int) -> { z: int | xa != 10 || z == r },
    b: <> (xb: int) -> { z: int | xb != 10 || z == r }
): { z: bool | z == false } / int => int {
    val same = test(r, a, b);
    if same then true else true
}
