// Migrated from arm/amb-2-SAT.ml
//
// Faithful migration of the recursive backtracking search (see amb_1).  Here
// the list contains the target e (at the head: Cons(e, l)).  The original
// asserts the search returns Success e; since the handler's answer type must
// also admit the backtracking Failure branch, the faithful checkable invariant
// is: the result is Failure or *exactly* Success(e) -- never a wrong element.
// This holds for the real scan over *any* list, because the final test only
// emits Success on an element equal to e.

type ilist  = | Nil | Cons of int * ilist
type opt_i  = | NoneI | SomeI of int
type result = | Failure | Success of int

effect Amb {
    select: () -> bool
}

def amb_find(e: int, l: ilist): { z: result | z == Failure || z == Success(e) } {
    handle <> { [r, ev] =>
        rec def select_from <amb> (xs: ilist):
            opt_i
            / { z: result | z == Failure || z == Success(e) }
           => { z: result | z == Failure || z == Success(e) } {
            match xs with
            | Nil -> { NoneI }
            | Cons (x, rest) -> {
                val chosen = raise amb.select[[]]();
                if chosen then SomeI(x) else select_from(rest)
            }
        };
        val found = select_from(Cons(e, l));
        (fun <> (): { z: result | z == Failure || z == Success(e) } {
            match found with
            | NoneI -> { Failure }
            | SomeI (x) -> { if x == e then Success(x) else Failure }
        })()
    } with amb: Amb {
        hdl_s select(k) {
            val res = resume k true;
            match res with
            | Failure -> { resume_final k false }
            | Success (y) -> { Success(y) }
        }
    }: { z: result | z == Failure || z == Success(e) }
}
