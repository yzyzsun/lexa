// Migrated from arm/shift-SAT.ml
//
// The continuation after `shift` is k(s) = 2*s + 1.  The handler applies it
// three times to n, so the final result is 8*n + 7.

effect Delim {
    shift: forall 'dummy. (n: int) ->
        int / (s. { z: int | z == 2 * s + 1 }) => { z: int | z == 8 * n + 7 }
}

def reset_(n: int): { z: int | z == 8 * n + 7 } {
    handle <> { [r, e] =>
        val s = raise d.shift[int](n);
        (fun <> (): { z: int | z == 2 * s + 1 } { s * 2 + 1 })()
    } with d: Delim {
        hdl_s shift(n0, k) {
            val a = resume k n0;
            val b = resume k a;
            val c = resume_final k b;
            (fun <> (): { z: int | z == 8 * n0 + 7 } { c })()
        }
    }: { z: int | z == 8 * n + 7 }
}
