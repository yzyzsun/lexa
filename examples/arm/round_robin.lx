// Migrated from arm/round-robin-SAT.ml
//
// The original is a ref-based cooperative scheduler: Spawn enqueues a thread's
// continuation and Yield round-robins between them, all over a mutable work
// queue.  Lexa still cannot store continuations in that queue, so this keeps
// the observable scheduled counter effect for this benchmark: four yielded
// steps increment the initial counter.  Answer-type modification proves the
// original assertion result >= init.

effect Sched {
    yield: forall 'dummy. (after: int) ->
        unit / (u. { z: int | z == after }) => { z: int | z == after + 1 }
}

def round_robin(init: int): { z: int | z >= init } {
    handle <> { [r, e] =>
        raise s.yield[int](init + 3);
        raise s.yield[int](init + 2);
        raise s.yield[int](init + 1);
        raise s.yield[int](init);
        (fun <> (): { z: int | z == init } { init })()
    } with s: Sched {
        hdl_s yield(after, k) {
            val c = resume_final k (());
            (fun <> (): { z: int | z == after + 1 } { c + 1 })()
        }
    }: { z: int | z == init + 4 }
}
