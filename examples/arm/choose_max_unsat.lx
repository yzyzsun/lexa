// Migrated from arm/choose-max-UNSAT.ml  (NEGATIVE TEST: must FAIL)
//
// Same two-choice max program as choose_max.lx, but with the original
// contradictory postcondition `u - y`.

effect Decide { decide: () -> bool }

def main(u: int, v: { z: int | z >= u }, x: int, y: { z: int | z >= x }): { z: int | z == u - y } {
    handle <> { [r, e] =>
        val d1 = raise dec.decide();
        val a = if d1 then u else (fun <> (): int { v })();
        val d2 = raise dec.decide();
        val b = if d2 then x else (fun <> (): int { y })();
        (fun <> (): int { a - b })()
    } with dec: Decide {
        hdl_s decide(k) {
            val t = resume k true;
            val f = resume_final k false;
            if t >= f then t else f
        }
    }: int
}
