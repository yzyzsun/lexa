// Migrated from arm/deferred-2-SAT.ml
//
// Same faithful deferred/lazy handler as deferred_1, with the thunk constructed
// inline from the input n.

type deferred = | Value of int | Thunk of int * (<> () -> int)

effect Deferred {
    force: forall 'rho: Reg, 'beta: Pred[int], 'gamma: Cty. (r: int) ->
        { z: int | z == r }
            / ((<>(deferred) ->['rho] { z: int | 'beta(z) } / 'gamma => 'gamma) / 'gamma => 'gamma)
            => (<>(deferred) ->['rho] { z: int | 'beta(z) } / 'gamma => 'gamma)
}

def test(n: int): { z: int | z == n } / int => int {
    val thunk = fun <> (): { z: int | z == n } { n };
    val run = handle <> {
        val res = raise d.force[top, Pred(z: Int) { z == n }, int](n);
        (fun <> (): { z: int | z == n } { res })()
    } with d: Deferred {
        return x {
            fun <> (st: deferred): { z: int | z == n } { x }
        }
        hdl_1 force(expected, k) {
            fun <> (st: deferred): { z: int | z == n } / int => int {
                match st with
                | Value (v) -> {
                    val next = resume_final k v;
                    next(Value(v))
                }
                | Thunk (ctx, t) -> {
                    val v = t();
                    val next = resume_final k v;
                    next(Value(v))
                }
            }
        }
    }: <>(deferred) -> { z: int | z == n } / int => int;
    run(Thunk(n, thunk))
}
