// Migrated from arm/select-UNSAT.ml  (NEGATIVE TEST: must FAIL)
// The search may return Success(-x); claiming it is always Success(x) is wrong.
type result = | Failure | Success of int
effect Select { choose: () -> bool }
def selection(x: int): { z: result | z == Failure || z == Success(x) } {
    handle <> {
        val b = raise s.choose();
        (fun <> (): { z: result | z == Failure || z == Success(x) } {
            if b then (if x * x == x * x then Success(x) else Failure)
            else (if (0 - x) * (0 - x) == x * x then Success(0 - x) else Failure)
        })()
    } with s: Select {
        hdl_s choose(k) {
            val r = resume k true;
            match r with
            | Failure -> { resume_final k false }
            | Success (y) -> { Success(y) }
        }
    }: { z: result | z == Failure || z == Success(x) }
}
