// Migrated from arm/expectation-SAT.ml
//
// `pick` is answer-modifying: if the operation returns true, the continuation
// must produce x; if it returns false, it must produce y.  The handler combines
// those two continuation answers into the weighted expectation
// p*x + (100-p)*y, matching the original assertion.

effect Pick {
    pick: forall 'dummy. (p: int, x: int, y: int) ->
        bool
            / (b. { z: int | (b == true && z == x) || (b == false && z == y) })
            => { z: int | z == p * x + (100 - p) * y }
}

def expectation(p: int, x: int, y: int): { z: int | z == p * x + (100 - p) * y } {
    handle <> { [r, e] =>
        val b = raise pick.pick[int](p, x, y);
        (fun <> (): { z: int | (b == true && z == x) || (b == false && z == y) } {
            if b then x else y
        })()
    } with pick: Pick {
        hdl_s pick(p0, x0, y0, k) {
            val ra = resume k true;
            val rb = resume_final k false;
            (fun <> (): { z: int | z == p0 * x0 + (100 - p0) * y0 } {
                p0 * ra + (100 - p0) * rb
            })()
        }
    }: { z: int | z == p * x + (100 - p) * y }
}
