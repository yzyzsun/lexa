// Migrated from arm/bfs-simpl-UNSAT.ml  (NEGATIVE TEST: must FAIL)
// The sqrt search may return Success(-a); claiming only Failure/Success(a) is wrong.
type result = | Failure | Success of int
effect Select { select: () -> bool }
def sqrt(a: int): { z: result | z == Failure || z == Success(a) } {
    handle <> { [r, e] =>
        val b = raise sel.select();
        val cand = if b then a else (0 - a);
        (fun <> (): { z: result | z == Failure || z == Success(a) } {
            if cand * cand == a * a then Success(cand) else Failure
        })()
    } with sel: Select {
        hdl_s select(k) {
            val r = resume k true;
            match r with
            | Failure -> { resume_final k false }
            | Success (y) -> { Success(y) }
        }
    }: { z: result | z == Failure || z == Success(a) }
}
