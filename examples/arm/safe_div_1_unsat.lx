// Migrated from arm/safe-div-1-UNSAT.ml  (NEGATIVE TEST: must FAIL)
// With m = 0 the result is None; the answer type wrongly claims a Some.
type opt = | None | Some of int
exceptional effect Div { divfail: () -> { z: opt | z == None } }
def safe_div(n: int, m: { z: int | z == 0 }): { z: opt | z != None } {
    handle <> { [reg, e] =>
        if m == 0 then raise d.divfail() else Some(n / m)
    } with d: Div { exc divfail() { None } }: { z: opt | z != None }
}
