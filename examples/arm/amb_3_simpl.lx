// Migrated from arm/amb-3-simpl-SAT.ml
//
// Boolean backtracking version of amb.  The branch value can be false, but the
// answer-modifying `select` handler computes boolean OR over the true/false
// continuations.  For the list [ep; e], the handled answer is exactly true.

type ilist = | Nil | Cons of int * ilist

effect Amb {
    select: forall 'dummy. (on_true: bool, on_false: bool) ->
        bool
            / (b. { z: bool | (b == true && z == on_true) || (b == false && z == on_false) })
            => { z: bool |
                ((on_true == true || on_false == true) && z == true) ||
                (on_true == false && on_false == false && z == false) }
}

def amb_find(ep: int, e: int): { z: bool | z == true } {
    handle <> { [r, ev] =>
        rec def select_from <amb> (xs: { z: ilist | z == Nil || z == Cons(e, Nil) || z == Cons(ep, Cons(e, Nil)) }):
            bool
            / { z: bool | (xs == Nil && z == false) || (xs != Nil && z == true) }
            => { z: bool | (xs == Nil && z == false) || (xs != Nil && z == true) } {
            match xs with
            | Nil -> { false }
            | Cons (x, rest) -> {
                val false_answer =
                    match rest with
                    | Nil -> { false }
                    | Cons (y, ys) -> { true };
                val c = raise amb.select[[]; int](x == e, false_answer);
                (fun <> (): { z: bool |
                    (c == true && x == e && z == true) ||
                    (c == true && x != e && z == false) ||
                    (c == false && z == false_answer) } {
                    if c then (if x == e then true else false) else false_answer
                })()
            }
        };
        val res = select_from(Cons(ep, Cons(e, Nil)));
        (fun <> (): bool { res })()
    } with amb: Amb {
        hdl_s select(on_true, on_false, k) {
            val r = resume k true;
            if r then
                (fun <> (): { z: bool |
                    ((on_true == true || on_false == true) && z == true) ||
                    (on_true == false && on_false == false && z == false) } { true })()
            else (
                val rf = resume_final k false;
                (fun <> (): { z: bool |
                    ((on_true == true || on_false == true) && z == true) ||
                    (on_true == false && on_false == false && z == false) } { rf })()
            )
        }
    }: { z: bool | z == true }
}
